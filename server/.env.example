PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/nour_portfolio
JWT_SECRET=change-this-long-random-secret
ADMIN_EMAIL=admin@nourmastouri.com
ADMIN_PASSWORD=NourCMS2026!
CLIENT_URL=http://localhost:5173
# Optional server-side maps provider key. Never expose this value in client code.
MAPS_API_KEY=
DNS_SERVERS=
# Optional fallback when Node cannot resolve a mongodb+srv DNS record:
MONGODB_FALLBACK_HOSTS=
MONGODB_FALLBACK_OPTIONS=authSource=admin&tls=true
